module SqlGen.Emit exposing (..)

import Sky.Core.Prelude exposing (..)
import Sky.Core.String as String
import Sky.Core.List as List
import Sky.Core.Dict as Dict
import SqlGen.Types exposing (..)
import SqlGen.Naming as Naming


header : String
header =
    "-- Code generated by sky-sqlgen; DO NOT EDIT.\n"


nl2 : String
nl2 =
    "\n\n"
-- ===========================================================================
-- Decimal support: import + the composed column decoder helper
-- ===========================================================================
-- Emitted once per module that decodes any Decimal column. There is no
-- built-in DbDecode.decimal, so a Decimal column is read as TEXT and parsed
-- losslessly via Std.Decimal.fromString.


decimalImportLine : String
decimalImportLine =
    "import Std.Decimal as Decimal\n"


decimalColHelper : String
decimalColHelper =
    "decimalCol : String -> Decoder Decimal\n" ++ "decimalCol col =\n"
        ++ "    DbDecode.string col\n"
        ++ "        |> DbDecode.andThen (\\s ->\n"
        ++ "            case Decimal.fromString s of\n"
        ++ "                Ok d -> DbDecode.succeed d\n"
        ++ "                Err _ -> DbDecode.fail (\"invalid decimal in column \" ++ col ++ \": \" ++ s))\n"


isDecimalType : SkyType -> Bool
isDecimalType t =
    case t of

        TDecimal ->
            True

        _ ->
            False


anyDecimal : List SkyType -> Bool
anyDecimal types =
    List.any isDecimalType types
-- ===========================================================================
-- Schema module
-- ===========================================================================


emitSchema : String -> Catalog -> String
emitSchema modulePrefix cat =
    let
        tables = List.filterMap (\k -> Dict.get k cat.tables) cat.order
-- The bare primitive (or decimalCol / money / nullable) decoder for a scalar
-- result's single column.
        needsDecimal =
            anyDecimal
                (List.concatMap
                    (\t -> List.map (\c -> c.skyType) t.columns)
                    tables)
        decimalImport =
            if needsDecimal then
                decimalImportLine

            else
                ""
        helperBlock =
            if needsDecimal then
                nl2 ++ decimalColHelper

            else
                ""
        head =
            header ++ "module " ++ modulePrefix ++ ".Schema exposing (..)\n\n"
                ++ "import Sky.Core.Prelude exposing (..)\n"
                ++ "import Std.Db.Decode as DbDecode\n"
                ++ decimalImport
        bodies = List.map emitTable tables
    in
        head ++ helperBlock ++ String.concat bodies ++ "\n"
-- Shared runtime helper: build N comma-joined `?` placeholders for IN-list
-- expansion. Emitted once per module that has any list param.


emitTable : CatTable -> String
emitTable table =
    nl2 ++ emitModelAlias table ++ nl2 ++ emitModelDecoder table


emitModelAlias : CatTable -> String
emitModelAlias table =
    "type alias " ++ table.modelName ++ " =\n"
        ++ emitRecordFields (List.map columnField table.columns)


columnField : CatColumn -> ( String, String )
columnField c =
    ( Naming.fieldName c.name, typeRef c.skyType c.nullable )


emitModelDecoder : CatTable -> String
emitModelDecoder table =
    table.decoderName ++ " : Decoder " ++ table.modelName ++ "\n"
        ++ table.decoderName
        ++ " =\n"
        ++ "    DbDecode.succeed "
        ++ table.modelName
        ++ "\n"
        ++ String.concat
               (List.map
                   (\c -> decoderLine c.name c.skyType c.nullable)
                   table.columns)
-- ===========================================================================
-- Query module
-- ===========================================================================


emitQueryModule : String -> String -> List ResolvedStatement -> String
emitQueryModule modulePrefix fileModule stmts =
    let
        modelImports = collectModelImports stmts
        schemaImport =
            if List.isEmpty modelImports then
                ""

            else
                "import " ++ modulePrefix ++ ".Schema exposing ("
                    ++ String.join ", " modelImports
                    ++ ")\n"
        needsDecimal = anyDecimal (collectRowTypes stmts)
        decimalImport =
            if needsDecimal then
                decimalImportLine

            else
                ""
        needsPlaceholders = List.any hasListParam stmts
        stringImport =
            if needsPlaceholders then
                "import Sky.Core.String as String\n"

            else
                ""
        dbImport =
            -- `SqlField` is an ambient kernel type and its constructors are
            -- referenced qualified (`Db.SetField` / `Db.OmitField`, valid in
            -- pattern position since #584), so a plain import suffices.
            "import Std.Db as Db\n"
        helperBlock =
            (if needsDecimal then
                nl2 ++ decimalColHelper

            else
                "")
                ++ (if needsPlaceholders then
                       nl2 ++ placeholdersHelper

                   else
                       "")
        head =
            header ++ "module " ++ modulePrefix ++ "." ++ fileModule
                ++ " exposing (..)\n\n"
                ++ "import Sky.Core.Prelude exposing (..)\n"
                ++ "import Sky.Core.List as List\n"
                ++ stringImport
                ++ "import Sky.Core.Task as Task\n"
                ++ "import Sky.Core.Error as Error exposing (Error)\n"
                ++ dbImport
                ++ "import Std.Db.Decode as DbDecode\n"
                ++ decimalImport
                ++ schemaImport
        bodies = List.map emitStatement stmts
    in
        head ++ helperBlock ++ String.concat bodies ++ "\n"


placeholdersHelper : String
placeholdersHelper =
    "placeholders : Int -> String\n" ++ "placeholders n =\n"
        ++ "    String.join \", \" (List.map (\\_ -> \"?\") (List.range 1 n))\n"


collectModelImports : List ResolvedStatement -> List String
collectModelImports stmts =
    dedup
        (List.concat
            (List.map
                (\s ->
                    case s.result of

                        ReuseModel model decoder ->
                            [ model, decoder ]

                        _ ->
                            [])
                stmts))
        []
-- Column types decoded *inline* in this module (RowType only). ReuseModel
-- statements decode via the Schema module's decoder, so their Decimal columns
-- are handled by the Schema-module helper, not this one.


collectRowTypes : List ResolvedStatement -> List SkyType
collectRowTypes stmts =
    List.concatMap
        (\s ->
            case s.result of

                RowType _ _ cols ->
                    List.map (\c -> c.skyType) cols

                ScalarType c ->
                    [c.skyType]

                _ ->
                    [])
        stmts


dedup : List String -> List String -> List String
dedup items acc =
    case items of

        [] ->
            List.reverse acc

        x :: rest ->
            if List.member x acc then
                dedup rest acc

            else
                dedup rest (x :: acc)


emitStatement : ResolvedStatement -> String
emitStatement s =
    let
        sectionHead =
            nl2 ++ "-- " ++ s.baseName ++ " :" ++ cardName s.card ++ "\n"
        rowBlock =
            case s.result of

                RowType rowType rowDecoder cols ->
                    nl2 ++ emitRowAlias rowType cols ++ nl2
                        ++ emitRowDecoder rowType rowDecoder cols

                _ ->
                    ""
        paramsBlock =
            if List.isEmpty s.params then
                ""

            else
                nl2 ++ emitParamsAlias s
        sqlBlock =
            if hasListParam s || isOmitBuilder s then
                -- list / @omit statements build their SQL at runtime (no constant)
                ""

            else
                nl2 ++ emitSqlConst s
        fnBlock = nl2 ++ emitFunction s
    in
        sectionHead ++ rowBlock ++ paramsBlock ++ sqlBlock ++ fnBlock


hasListParam : ResolvedStatement -> Bool
hasListParam s =
    List.any (\p -> p.isList) s.params


isOmitBuilder : ResolvedStatement -> Bool
isOmitBuilder s =
    not (List.isEmpty s.insertCols)


emitRowAlias : String -> List ResolvedColumn -> String
emitRowAlias rowType cols =
    "type alias " ++ rowType ++ " =\n"
        ++ emitRecordFields
               (List.map (\c -> ( c.field, typeRef c.skyType c.nullable )) cols)


emitRowDecoder : String -> String -> List ResolvedColumn -> String
emitRowDecoder rowType rowDecoder cols =
    rowDecoder ++ " : Decoder " ++ rowType ++ "\n" ++ rowDecoder ++ " =\n"
        ++ "    DbDecode.succeed "
        ++ rowType
        ++ "\n"
        ++ String.concat
               (List.map (\c -> decoderLine c.column c.skyType c.nullable) cols)


emitParamsAlias : ResolvedStatement -> String
emitParamsAlias s =
    "type alias " ++ s.baseName ++ "Params =\n"
        ++ emitRecordFields
               (List.map (\p -> ( p.field, paramTypeRef p )) s.params)
-- A list param renders `List <base>`; a scalar param uses the usual Maybe/bare.


paramTypeRef : ResolvedParam -> String
paramTypeRef p =
    if p.isOmit then
        "SqlField"

    else if p.isList then
        "List " ++ skyTypeName p.skyType

    else
        typeRef p.skyType p.nullable


emitSqlConst : ResolvedStatement -> String
emitSqlConst s =
    let
        name = s.fnName ++ "Sql"
    in
        name ++ " : String\n" ++ name ++ " =\n" ++ "    \"\"\"" ++ s.sql
            ++ "\"\"\"\n"


emitFunction : ResolvedStatement -> String
emitFunction s =
    let
        hasParams = not (List.isEmpty s.params)
        paramArgType =
            if hasParams then
                " -> " ++ s.baseName ++ "Params"

            else
                ""
        paramArgName =
            if hasParams then
                " params"

            else
                ""
        sig =
            s.fnName ++ " : Db" ++ paramArgType ++ " -> " ++ returnType s
                ++ "\n"
        defHead = s.fnName ++ " db" ++ paramArgName ++ " =\n"
    in
        if isOmitBuilder s then
            sig ++ defHead ++ emitOmitCall s

        else if hasListParam s then
            -- runtime-built SQL + spread args inside a let
            let
                sqlExpr = emitListSqlExpr s.sqlChunks s.sqlListFields
                argsExpr = emitListArgs s
                letBlock =
                    "    let\n        sql =\n            " ++ sqlExpr
                        ++ "\n\n        args =\n            "
                        ++ argsExpr
                        ++ "\n    in\n"
            in
                sig ++ defHead ++ letBlock ++ emitBody s "sql" "args"

        else
            sig ++ defHead ++ emitBody s (s.fnName ++ "Sql") (emitArgsList s)


returnType : ResolvedStatement -> String
returnType s =
    case s.card of

        COne ->
            "Task Error (Maybe " ++ rowName s ++ ")"

        CMany ->
            "Task Error (List " ++ rowName s ++ ")"

        CExec ->
            "Task Error ()"

        CExecRows ->
            "Task Error Int"

        CScalar ->
            "Task Error (Maybe " ++ scalarElem s ++ ")"

        CScalarMany ->
            "Task Error (List " ++ scalarElem s ++ ")"


rowName : ResolvedStatement -> String
rowName s =
    case s.result of

        ReuseModel model _ ->
            model

        RowType rowType _ _ ->
            rowType

        ScalarType c ->
            scalarElemCol c

        NoResult ->
            "()"
-- The element type of a scalar result: parenthesised when the column itself is
-- nullable (e.g. `:scalarmany` of a nullable column -> `List (Maybe String)`).


scalarElem : ResolvedStatement -> String
scalarElem s =
    case s.result of

        ScalarType c ->
            scalarElemCol c

        _ ->
            "()"


scalarElemCol : ResolvedColumn -> String
scalarElemCol c =
    if c.nullable then
        "(Maybe " ++ skyTypeName c.skyType ++ ")"

    else
        skyTypeName c.skyType


decoderRef : ResolvedStatement -> String
decoderRef s =
    case s.result of

        ReuseModel _ decoder ->
            decoder

        RowType _ decoder _ ->
            decoder

        ScalarType _ ->
            ""

        NoResult ->
            ""


emitBody : ResolvedStatement -> String -> String -> String
emitBody s sqlName argsList =
    case s.card of

        COne ->
            "    Db.queryDecode db " ++ sqlName ++ " " ++ argsList ++ " "
                ++ decoderRef s
                ++ "\n        |> Task.map List.head\n"

        CMany ->
            "    Db.queryDecode db " ++ sqlName ++ " " ++ argsList ++ " "
                ++ decoderRef s
                ++ "\n"

        CExec ->
            "    Db.exec db " ++ sqlName ++ " " ++ argsList
                ++ "\n        |> Task.map (\\_ -> ())\n"

        CExecRows ->
            "    Db.exec db " ++ sqlName ++ " " ++ argsList ++ "\n"

        CScalar ->
            "    Db.queryDecode db " ++ sqlName ++ " " ++ argsList ++ " ("
                ++ scalarDecoder s
                ++ ")\n        |> Task.map List.head\n"

        CScalarMany ->
            "    Db.queryDecode db " ++ sqlName ++ " " ++ argsList ++ " ("
                ++ scalarDecoder s
                ++ ")\n"


scalarDecoder : ResolvedStatement -> String
scalarDecoder s =
    case s.result of

        ScalarType c ->
            decoderExpr c.column c.skyType c.nullable

        _ ->
            ""


emitArgsList : ResolvedStatement -> String
emitArgsList s =
    let
        typeMap = paramTypeMap s.params
        exprs = List.map (\field -> argExpr field typeMap) s.argOrder
    in
        if List.isEmpty exprs then
            "[]"

        else
            "[ " ++ String.join ", " exprs ++ " ]"


paramTypeMap : List ResolvedParam -> Dict String ResolvedParam
paramTypeMap params =
    List.foldl (\p acc -> Dict.insert p.field p acc) Dict.empty params


argExpr : String -> Dict String ResolvedParam -> String
argExpr field typeMap =
    case Dict.get field typeMap of

        Just p ->
            if p.nullable then
                sqlFromMaybe p.skyType ++ " params." ++ field

            else
                sqlValueCtor p.skyType ++ " params." ++ field

        Nothing ->
            "params." ++ field
-- ===========================================================================
-- IN (@list) runtime SQL + args emission
-- ===========================================================================
-- sql expression: chunk0 ++ placeholders (List.length params.f0) ++ chunk1 ++ …


emitListSqlExpr : List String -> List String -> String
emitListSqlExpr chunks listFields =
    let
        phs =
            List.map
                (\f -> "placeholders (List.length params." ++ f ++ ")")
                listFields
        pieces = interleaveStr (List.map quoteChunk chunks) phs
    in
        String.join " ++ " pieces


quoteChunk : String -> String
quoteChunk c =
    if String.isEmpty c then
        "\"\""

    else
        "\"\"\"" ++ c ++ "\"\"\""
-- interleave [c0,c1,c2] [p0,p1] = [c0,p0,c1,p1,c2]


interleaveStr : List String -> List String -> List String
interleaveStr chunks phs =
    case chunks of

        [] ->
            []

        c :: restChunks ->
            case phs of

                [] ->
                    [c]

                p :: restPhs ->
                    c :: p :: interleaveStr restChunks restPhs
-- args expression: List.concat [ <group>, <group>, … ] in placeholder order;
-- a scalar group is a singleton list, a list group is List.map over the param.


emitListArgs : ResolvedStatement -> String
emitListArgs s =
    let
        typeMap = paramTypeMap s.params
        groups = List.map (\field -> argGroupExpr field typeMap) s.argOrder
    in
        if List.isEmpty groups then
            "[]"

        else
            "List.concat [ " ++ String.join ", " groups ++ " ]"


argGroupExpr : String -> Dict String ResolvedParam -> String
argGroupExpr field typeMap =
    case Dict.get field typeMap of

        Just p ->
            if p.isList then
                "List.map (\\x -> " ++ sqlValueCtor p.skyType ++ " x) params."
                    ++ field

            else if p.nullable then
                "[ " ++ sqlFromMaybe p.skyType ++ " params." ++ field ++ " ]"

            else
                "[ " ++ sqlValueCtor p.skyType ++ " params." ++ field ++ " ]"

        Nothing ->
            "[ params." ++ field ++ " ]"
-- ===========================================================================
-- DEFAULT-omittable INSERT (`-- @omit`) emission
-- ===========================================================================
-- Emits a single `Db.insertFields db "<table>" [ (col, SqlField), ... ]` call.
-- Omittable columns pass their `SqlField` param straight through; non-omittable
-- columns are wrapped in `Db.SetField (...)`. The runtime drops `OmitField`
-- columns (DB DEFAULT applies) and binds the rest. Column names are schema
-- LITERALS (no injection surface).


-- @omit INSERT: with a RETURNING result -> insertFieldsReturning (decode the
-- returned rows); otherwise -> insertFields (affected-row count / unit).
emitOmitCall : ResolvedStatement -> String
emitOmitCall s =
    case s.result of
        NoResult ->
            emitInsertFields s

        _ ->
            emitInsertFieldsReturning s


omitPairList : ResolvedStatement -> String
omitPairList s =
    "[ " ++ String.join "\n        , " (List.map pairElem s.insertCols) ++ "\n        ]"


emitInsertFields : ResolvedStatement -> String
emitInsertFields s =
    let
        call =
            "    Db.insertFields db \"" ++ s.insertTable ++ "\"\n        " ++ omitPairList s ++ "\n"
    in
        case s.card of
            CExec ->
                call ++ "        |> Task.map (\\_ -> ())\n"

            _ ->
                call


emitInsertFieldsReturning : ResolvedStatement -> String
emitInsertFieldsReturning s =
    let
        call =
            "    Db.insertFieldsReturning db \"" ++ s.insertTable ++ "\"\n        "
                ++ omitPairList s
                ++ "\n        \"" ++ returningProjection s.result ++ "\"\n        "
                ++ decoderArg s ++ "\n"
    in
        case s.card of
            COne ->
                call ++ "        |> Task.map List.head\n"

            CScalar ->
                call ++ "        |> Task.map List.head\n"

            _ ->
                call


-- The RETURNING projection text. ReuseModel reuses the table Model, so emit `*`
-- (the decoder reads by column name); RowType/ScalarType list their columns.
returningProjection : ResultShape -> String
returningProjection r =
    case r of
        ReuseModel _ _ ->
            "*"

        RowType _ _ cols ->
            String.join ", " (List.map (\c -> c.column) cols)

        ScalarType c ->
            c.column

        NoResult ->
            ""


decoderArg : ResolvedStatement -> String
decoderArg s =
    case s.card of
        CScalar ->
            "(" ++ scalarDecoder s ++ ")"

        CScalarMany ->
            "(" ++ scalarDecoder s ++ ")"

        _ ->
            decoderRef s


pairElem : InsertCol -> String
pairElem ic =
    if ic.omittable then
        "( \"" ++ ic.sqlCol ++ "\", params." ++ ic.field ++ " )"

    else
        let
            inner =
                if ic.nullable then
                    sqlFromMaybe ic.skyType ++ " params." ++ ic.field

                else
                    sqlValueCtor ic.skyType ++ " params." ++ ic.field
        in
            "( \"" ++ ic.sqlCol ++ "\", Db.SetField (" ++ inner ++ ") )"
-- ===========================================================================
-- Shared field / type rendering
-- ===========================================================================


typeRef : SkyType -> Bool -> String
typeRef t nullable =
    if nullable then
        "Maybe " ++ skyTypeName t

    else
        skyTypeName t


decoderExpr : String -> SkyType -> Bool -> String
decoderExpr column t nullable =
    let
        inner = dbDecodePrim t ++ " \"" ++ column ++ "\""
    in
        if nullable then
            "DbDecode.nullable (" ++ inner ++ ")"

        else
            inner


decoderLine : String -> SkyType -> Bool -> String
decoderLine column t nullable =
    "        |> DbDecode.andMap (" ++ decoderExpr column t nullable ++ ")\n"


emitRecordFields : List ( String, String ) -> String
emitRecordFields fields =
    case fields of

        [] ->
            "    {}\n"

        first :: rest ->
            "    { " ++ fieldLine first
                ++ String.concat (List.map (\f -> "    , " ++ fieldLine f) rest)
                ++ "    }\n"


fieldLine : ( String, String ) -> String
fieldLine pair =
    fst pair ++ " : " ++ snd pair ++ "\n"
